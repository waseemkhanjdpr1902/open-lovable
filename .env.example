# Codely production configuration
# Never commit real secret values to GitHub.

# Required: website analysis and brand extraction
FIRECRAWL_API_KEY=

# Required: AI generation
GEMINI_API_KEY=

# Required: application preview/runtime
SANDBOX_PROVIDER=vercel

# Vercel deployments use the automatically injected VERCEL_OIDC_TOKEN.
# The three values below are only a fallback for environments without OIDC.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# Optional: speeds up large code edits
MORPH_API_KEY=
